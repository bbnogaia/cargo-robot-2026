System cargocompany1

/*
 * MESSAGES -------------------------------------------------------------------------
 */

// cargoservice <-> webgui
Request requestToLoad : requestToLoad(NOARGS)
Reply loadAccepted : loadAccepted(ANSWER) for requestToLoad
Reply loadRejected : loadRejected(ANSWER) for requestToLoad
Reply loadRetryLater : loadRetryLater(ANSWER) for requestToLoad

// cargoservice <-> cargohold
Request requestSlot : requestSlot(NOARGS)
Reply slotReserved : slotReserved(ANSWER) for requestSlot
Reply slotFailed : slotFailed(REASON) for requestSlot

Request setSlot : setSlot(SLOTID, STATE)
Reply setSlotChanged : setSlotChanged(NOARGS) for setSlot
Reply setSlotFailed : setSlotFailed(REASON) for setSlot

Request requestPosition : requestPosition(LOCATION)
Reply slotPosition : slotPosition(X, Y) for requestPosition
Reply positionFailed : positionFailed(REASON) for requestPosition

// cargoservice <-> robotsmart (cargorobot)
Request moverobot : moverobot(TARGETX, TARGETY, STEPTIME)
Reply moverobotdone : moverobotdone(ARG) for moverobot 
Reply moverobotfailed : moverobotfailed(PLANDONE, PLANTODO) for moverobot 

// (mock) sensor
Dispatch containerArrived : containerArrived(ARG)


/* -------------------------------------------------------------------------
 * CONTEXTS
 * -------------------------------------------------------------------------
 */
Context ctxcargocompany ip [ host="localhost" port=8040] 
Context ctxrobotsmart ip [host="127.0.0.1" port=8020 ]

ExternalQActor robotsmart context ctxrobotsmart


/* -------------------------------------------------------------------------
 * CARGOHOLD 
 * -------------------------------------------------------------------------
 */
QActor cargohold context ctxcargocompany{
    import "main.java.cargoHold.model.*"

	[#
		var hold: IHold = Hold()
	#]
		
    State s0 initial {
        println("$name | init e caricamento modello CargoHold tramite withobj") color cyan
    }
    Goto waitingRequests

    State waitingRequests {
        println("$name | in attesa di richieste di gestione slot/posizioni...") color cyan
    }
    Transition t0
        whenRequest requestSlot -> handleRequestSlot
        whenRequest setSlot -> handleSetSlot
        whenRequest requestPosition -> handleRequestPosition

    // 1. Gestione richiesta slot libero
    State handleRequestSlot {
        onMsg( requestSlot : requestSlot(NOARGS) ) {
            [#
                var hasSpace = hold.hasFreeSlot()
            #]
            if [# hasSpace #] {
                [#
                    val freeSlot = hold.getFirstFreeSlot()
                    val AssignedId = freeSlot.getId()
                    freeSlot.setSlotStatus(SlotStatus.RESERVED)
                #]
                println("$name | Slot riservato: $AssignedId") color cyan
                replyTo requestSlot with slotReserved : slotReserved($AssignedId)
            } else {
                println("$name | Nessuno slot libero disponibile") color red
                replyTo requestSlot with slotFailed : slotFailed(nospace)
            }
        }
    }
    Goto waitingRequests

    // 2. Gestione aggiornamento stato slot (free, reserved, occupied)
    State handleSetSlot {
        onMsg( setSlot : setSlot(SLOTID, STATE) ) {
            [#
                val sId = payloadArg(0)
                val sState = payloadArg(1)
                val slotObj = hold.getSlot(sId)
            #]
            if [# slotObj != null #] {
                [#
                    when (sState) {
                        "free" -> slotObj.setSlotStatus(SlotStatus.FREE)
                        "reserved" -> slotObj.setSlotStatus(SlotStatus.RESERVED)
                        "occupied" -> slotObj.setSlotStatus(SlotStatus.OCCUPIED)
                    }
                #]
                println("$name | Slot $sId aggiornato a stato: $sState") color cyan
                replyTo setSlot with setSlotChanged : setSlotChanged(NOARGS)
            } else {
                replyTo setSlot with setSlotFailed : setSlotFailed(notfound)
            }
        }
    }
    Goto waitingRequests

    // 3. Richiesta coordinate di uno slot, IOPort o HOME
    State handleRequestPosition {
        onMsg( requestPosition : requestPosition(LOCATION) ) {
            [#
                val locId = payloadArg(0)
                var PosX = 0
                var PosY = 0
                var found = false
                
                if (locId == "ioport") {
                    val pIOPort = hold.getIOPortPosition()
                    if (pIOPort != null) {
                        PosX = pIOPort.getX()
                        PosY = pIOPort.getY()
                        found = true
                    }
                } else if (locId == "home") {
                    val pHome = hold.getHomePosition()
                    if (pHome != null) {
                        PosX = pHome.getX()
                        PosY = pHome.getY()
                        found = true
                    }
                } else {
                    val pos = hold.getSlotPosition(locId)
                    if (pos != null) {
                        PosX = pos.getX()
                        PosY = pos.getY()
                        found = true
                    }
                }
            #]
            if [# found #] {
                println("$name | Posizione per $locId: ($PosX, $PosY)") color cyan
                replyTo requestPosition with slotPosition : slotPosition($PosX, $PosY)
            } else {
                replyTo requestPosition with positionFailed : positionFailed(notfound)
            }
        }
    }
    Goto waitingRequests
}

/* -------------------------------------------------------------------------
 * CARGOSERVICE
 * -------------------------------------------------------------------------
 */
QActor cargoservice context ctxcargocompany {

    [#
        var AssignedSlotId: String = ""
        var TargetX: Int = 0
        var TargetY: Int = 0
        var Slot5X: Int = 0
        var Slot5Y: Int = 0 
        var HomeX: Int = 0
        var HomeY: Int = 0      
        var IOPortX: Int = 0
        var IOPortY: Int = 0
    #]
    
    /**
     *  STATE INIT: ----------------------------------------------------------
     *  caricamento delle coordinate fisse: IOPort, Slot5, Home
     */
     
    State initAskIOPort initial {
        println("$name | init cargoservice: richiedo posizioni fisse (ioport, slot5, home)...") color green
        delay 1000 // Piccolo delay per assicurarsi che cargohold sia pronto ad accettare richieste
        request cargohold -m requestPosition : requestPosition(ioport)
    }
    Transition tInit1
        whenReply slotPosition -> initAskSlot5
        whenReply positionFailed -> initError

    State initAskSlot5 {
        onMsg( slotPosition : slotPosition(X, Y) ) {
            [#
                IOPortX = payloadArg(0).toInt()
                IOPortY = payloadArg(1).toInt()
            #]
            println("$name | IOPort caricata: ($IOPortX, $IOPortY). Richiesta Slot5...") color green
            request cargohold -m requestPosition : requestPosition(slot5)
        }
    }
    Transition tInit2
        whenReply slotPosition -> initAskHome
        whenReply positionFailed -> initError

    State initAskHome {
        onMsg( slotPosition : slotPosition(X, Y) ) {
            [#
                Slot5X = payloadArg(0).toInt()
                Slot5Y = payloadArg(1).toInt()
            #]
            println("$name | Slot5 caricato: ($Slot5X, $Slot5Y). Richiesta HOME...") color green
            request cargohold -m requestPosition : requestPosition(home)
        }
    }
    Transition tInit3
        whenReply slotPosition -> initComplete
        whenReply positionFailed -> initError

    State initComplete {
        onMsg( slotPosition : slotPosition(X, Y) ) {
            [#
                HomeX = payloadArg(0).toInt()
                HomeY = payloadArg(1).toInt()
            #]
            println("$name | HOME caricata: ($HomeX, $HomeY). Init completato!") color green
        }
    }
    Goto disengaged

    State initError {
        println("$name | ERRORE: Impossibile recuperare le posizioni fisse da cargohold all'avvio!") color red
    }

     /**
     *  STATE DISENGAGED: ----------------------------------------------------------
     *  il sistema rimane in attesa di richieste di carico
     */
    State disengaged {
        println("$name | disengaged (in attesa di richieste)") color magenta
    }
    Transition t0
        whenRequest requestToLoad -> handleLoad
        
    /**
     *  STATE LOAD: -------------------------------------------------------------------
     *  il sistema riceve una richiesta di carico
     *  e verifica la disponibilità degli slot
     */
    State handleLoad {
        onMsg( requestToLoad : requestToLoad(NOARGS) ) {
            println("$name | ricevuta richiesta requestToLoad") color magenta
            request cargohold -m requestSlot : requestSlot(NOARGS)
        }
    }
    Transition t1
        whenReply slotReserved -> confirmLoadToClient
        whenReply slotFailed -> handleLoadFailed

    State handleLoadFailed {
        println("$name | Nessuno slot disponibile. Rispondo loadRejected.") color magenta
        replyTo requestToLoad with loadRejected : loadRejected(rejected)
    }
    Goto disengaged

    // 1. Accetta subito la richiesta verso la webgui
    State confirmLoadToClient {
        onMsg( slotReserved : slotReserved(ANSWER) ) {
            [# AssignedSlotId = payloadArg(0) #]
            println("$name | Slot assegnato: $AssignedSlotId. Invio loadAccepted alla webgui.") color magenta
            replyTo requestToLoad with loadAccepted : loadAccepted($AssignedSlotId)
        }
    }
    Goto askSlotPosition

    // 2. Richiede solo la posizione dello slot assegnato
    State askSlotPosition {
        println("$name | Richiesta coordinate slot $AssignedSlotId...") color magenta
        request cargohold -m requestPosition : requestPosition($AssignedSlotId)
    }
    Transition t2
        whenReply slotPosition -> saveSlotPosition
        whenReply positionFailed -> handlePositionFail

    State saveSlotPosition {
        onMsg( slotPosition : slotPosition(X, Y) ) {
            [#
                TargetX = payloadArg(0).toInt()
                TargetY = payloadArg(1).toInt()
            #]
            println("$name | Coordinate $AssignedSlotId memorizzate: ($TargetX, $TargetY).") color magenta
        }
    }
    Goto waitForContainer
    
    State handlePositionFail {
    	println("$name | Slot inesistente...") color magenta
    }
    Goto disengaged

     /**
     *  STATE WAITCONTAINER: -------------------------------------------------------------------------------------
     *  attesa del posizionamento del container
     */
     
    State waitForContainer {
        println("$name | In attesa del container nell'area sensore (max 30s)...") color magenta
    }
    Transition t6
        whenTime 30000 -> handleTimeout // Timeout scaduto (30 secondi)
        whenMsg containerArrived -> moveToIOPort  

    // --- GESTIONE TIMEOUT (30s passati senza container) ---
    State handleTimeout {
        println("$name | TIMEOUT: container non posizionato entro 30 secondi! Ripristino slot libero...") color red
        request cargohold -m setSlot : setSlot($AssignedSlotId, free)
    }
    Transition t7
        whenReply setSlotChanged -> disengaged
        whenReply setSlotFailed -> disengaged


	 /**
     *  STATE ENGAGED: ----------------------------------------------------------
     *  il sistema riceve una richiesta di carico
     *  e verifica la disponibilità degli slot
     */


    // --- STEP 0: Il robot raggiunge l'IOPort per prelevare il container ---
    State moveToIOPort {
        println("$name | Container rilevato! Comando cargorobot verso IOPort in coordinate ($IOPortX, $IOPortY)") color magenta
        request robotsmart -m moverobot : moverobot($IOPortX, $IOPortY, 330)
    }
    Transition t8
        whenReply moverobotdone -> moveToSlot5
        whenReply moverobotfailed -> handlePreDeliveryFailure

    // --- STEP 1: Muove il robot dall'IOPort allo slot5 per la marcatura ---
    State moveToSlot5 {
        delay 2000
        println("$name | IOPort raggiunta. Comando cargorobot verso slot5 (marcatura) in coordinate ($Slot5X, $Slot5Y)") color magenta
        request robotsmart -m moverobot : moverobot($Slot5X, $Slot5Y, 330)
    }
    Transition t9
        whenReply moverobotdone -> markContainer
        whenReply moverobotfailed -> handlePreDeliveryFailure

    // --- STEP 2: Attesa marcatura (simulata con delay o segnale marker) ---
    State markContainer {
        println("$name | container allo slot5. Attesa marcatura barcode...") color magenta
        delay 3000 // Simulazione tempo di marcatura
    }
    Goto moveToFinalSlot

    // --- STEP 3: Muove il robot dallo slot5 allo slot finale riservato ---
    State moveToFinalSlot {
        println("$name | marcatura completata. Comando cargorobot verso lo slot finale: $AssignedSlotId ($TargetX, $TargetY)") color magenta
        request robotsmart -m moverobot : moverobot( $TargetX, $TargetY, 330)
    }
    Transition t10
        whenReply moverobotdone -> finalizeStorage
        whenReply moverobotfailed -> handlePreDeliveryFailure

    // --- STEP 4: Finalizzazione nello storage ---
    State finalizeStorage {
        println("$name | Container posizionato. Aggiornamento stato slot $AssignedSlotId ad OCCUPIED...") color green
        request cargohold -m setSlot : setSlot($AssignedSlotId, occupied)
    }
    Transition t11
        whenReply setSlotChanged -> returnToHome
        whenReply setSlotFailed -> returnToHome

    // --- STEP 5: Il robot ritorna alla HOME ---
    State returnToHome {
        println("$name | Operazione completata. Comando di ritorno alla HOME ($HomeX, $HomeY)...") color magenta
        request robotsmart -m moverobot : moverobot($HomeX, $HomeY, 330)
    }
    Transition t12
        whenReply moverobotdone -> finishOperation
        whenReply moverobotfailed -> handlePostDevliveryFailure

    State finishOperation {
        println("$name | Cargorobot rientrato alla HOME con successo. Sistema disengaged.") color green
    }
    Goto disengaged

    // --- STATE: GESTIONE ERRORI ROBOT ---
    State handlePreDeliveryFailure {
        println("$name | errore pre-delivery: movimento del cargorobot fallito!") color red
        request cargohold -m setSlot : setSlot($AssignedSlotId, free)
    }
    Transition tPreError
        whenReply setSlotChanged -> returnToHome
        whenReply setSlotFailed -> returnToHome

    State handlePostDevliveryFailure {
        println("$name | Errore post-delivery: movimento del cargorobot fallito! Tentativo di rientro HOME...") color red
        request robotsmart -m moverobot : moverobot($HomeX, $HomeY, 330)
    }
    Transition tPostHome
        whenReply moverobotdone -> disengaged
        whenReply moverobotfailed -> handlePostDevliveryFailure
}

/* -------------------------------------------------------------------------
 * MOCK SONAR
 * -------------------------------------------------------------------------
 */
QActor mocksonar context ctxcargocompany {
    State s0 initial {
        println("$name | init mocksonar") color cyan
    }
    Goto mockDetection

    State mockDetection {
        // Attende qualche secondo prima di simulare il posizionamento
        delay 6000
        println("$name | rilevato container nell'area sensore! Invio containerArrived...") color cyan
        forward cargoservice -m containerArrived : containerArrived(ok)

        delay 15000
    }
    Goto mockDetection
}


/* -------------------------------------------------------------------------
 * MOCK WEB-GUI
 * -------------------------------------------------------------------------
 */
QActor mockwebgui context ctxcargocompany {
    
    State s0 initial {
        println("$name | init ") color yellow   
    }
    Goto mockReq
    
    State mockReq {
        println("$name | Simulazione richiesta requestToLoad...") color yellow
        // simuliamo una richiesta di carico verso cargoservice
		request cargoservice -m requestToLoad : requestToLoad(NOARGS)
    }
    Transition t0
        whenReply loadAccepted -> handleAccepted
        whenReply loadRejected -> handleRejected
        whenReply loadRetryLater -> handleRetry
    
    State handleAccepted {
        onMsg( loadAccepted : loadAccepted(ANSWER) ) {
            [# var ans = payloadArg(0) #]
            println("$name | Richiesta ACCETTATA. Slot: $ans") color yellow
        }
        delay 14000
    }
    Goto mockReq

    State handleRejected {
        println("$name | Richiesta RIFIUTATA") color yellow
        delay 14000
    }
    Goto mockReq

    State handleRetry {
        println("$name | Richiesta RETRY LATER") color yellow
        delay 14000
    }
    Goto mockReq
}